APP_ENV=local
FLASK_DEBUG=false
FLASK_APP=run.py

SECRET_KEY=change-this-to-a-long-random-secret
DATABASE_URL=postgresql+psycopg://starx:starx@127.0.0.1:5432/starx_daily_report

UPLOAD_ROOT=storage/uploads
MAX_UPLOAD_MB=10
MAX_IMAGES_PER_SECTION=3
DAILY_REPORT_MAX_FILES_PER_SECTION=3
DAILY_REPORT_DIRECT_UPLOAD_ENABLED=true
DAILY_REPORT_MAX_FILES=30
DAILY_REPORT_MAX_FILE_BYTES=26214400
DAILY_REPORT_MAX_TOTAL_BYTES=314572800
DAILY_REPORT_UPLOAD_CONCURRENCY=3
DAILY_REPORT_PRESIGN_TTL_SECONDS=900
DAILY_REPORT_SESSION_TTL_SECONDS=86400

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# memory:// is appropriate for local/internal single-process use. Redis is optional.
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/2
RATELIMIT_LOGIN_LIMIT=5 per minute
RATELIMIT_EXPORT_LIMIT=10 per hour

# Strict storage policy (ZIPs are generated locally per request; legacy jobs remain readable)
UPLOAD_SELECTION_TTL_SECONDS=7200
UPLOAD_SELECTION_MAX_FILES=500
UPLOAD_SELECTION_MAX_BYTES=2147483648
UPLOAD_SINGLE_FILE_MAX_BYTES=314572800
DOWNLOAD_SINGLE_FILE_MAX_BYTES=314572800
STORAGE_QUOTA_BYTES=536870912000
DOWNLOAD_MONTHLY_QUOTA_BYTES=1099511627776
BULK_DOWNLOAD_MAX_FILES=100
BULK_DOWNLOAD_MAX_TOTAL_BYTES=314572800
BULK_DOWNLOAD_ZIP_TTL_SECONDS=86400
BULK_DOWNLOAD_TEMP_ROOT=tmp/bulk_downloads
CELERY_TASK_TIME_LIMIT_BULK_DOWNLOAD_SECONDS=1800
