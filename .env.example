# StarX environment template. Copy to a protected local/host file; never
# commit the copy. Values marked REQUIRED must be set before production starts.

# Application (REQUIRED)
# Allowed exactly: local, development, testing, production.
APP_ENV=local
FLASK_DEBUG=false
SECRET_KEY=replace-with-a-generated-local-development-secret-at-least-32-characters
STATIC_ASSET_VERSION=20260725-8106
MAX_UPLOAD_MB=10
MAX_IMAGES_PER_SECTION=3

# Database (REQUIRED in every non-test environment)
DATABASE_URL=postgresql+psycopg://starx:replace-this-local-password@127.0.0.1:5432/starx_daily_report

# Redis / Celery (REQUIRED in production; optional local defaults shown)
RATELIMIT_STORAGE_URI=memory://
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=false
REPORT_UPLOAD_CLEANUP_INTERVAL_SECONDS=3600
MEDIA_RECONCILIATION_INTERVAL_SECONDS=900
BULK_DOWNLOAD_CLEANUP_INTERVAL_SECONDS=3600

# S3-compatible storage (REQUIRED in production; example values are unusable)
STORAGE_PROVIDER=fake
STORAGE_ENDPOINT_URL=https://object-storage.example.invalid
STORAGE_BUCKET=replace-with-private-bucket
STORAGE_REGION=replace-with-region
STORAGE_PREFIX=starx-report
STORAGE_ACCESS_KEY_ID=replace-with-local-access-key
STORAGE_SECRET_ACCESS_KEY=replace-with-local-secret-key
STORAGE_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000

# Security / proxy (REQUIRED in production behind Nginx)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
TRUST_PROXY_HOPS=0
TRUSTED_HOSTS=localhost,127.0.0.1

# Worker / scheduler
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
DATABASE_READY_TIMEOUT_SECONDS=60

# Upload/media limits
DAILY_REPORT_DIRECT_UPLOAD_ENABLED=true
DAILY_REPORT_MAX_FILES=30
DAILY_REPORT_MAX_FILES_PER_SECTION=3
DAILY_REPORT_MAX_FILE_BYTES=26214400
DAILY_REPORT_MAX_TOTAL_BYTES=314572800
DAILY_REPORT_UPLOAD_CONCURRENCY=3
DAILY_REPORT_PRESIGN_TTL_SECONDS=900
DAILY_REPORT_SESSION_TTL_SECONDS=86400
UPLOAD_SELECTION_TTL_SECONDS=7200
UPLOAD_SELECTION_MAX_FILES=500
UPLOAD_SELECTION_MAX_BYTES=2147483648
UPLOAD_SINGLE_FILE_MAX_BYTES=314572800
STORAGE_PRESIGNED_POST_MULTIPART_OVERHEAD_BYTES=1048576
DOWNLOAD_SINGLE_FILE_MAX_BYTES=314572800
STORAGE_QUOTA_BYTES=536870912000
DOWNLOAD_MONTHLY_QUOTA_BYTES=1099511627776
BULK_DOWNLOAD_MAX_FILES=100
BULK_DOWNLOAD_MAX_TOTAL_BYTES=314572800
BULK_DOWNLOAD_ZIP_TTL_SECONDS=86400

# Optional local development paths only. Production containers use /app/tmp
# and S3; do not configure public filesystem serving.
UPLOAD_ROOT=storage/uploads
TMP_ROOT=tmp
MEDIA_TEMP_ROOT=tmp/media_processing
BULK_DOWNLOAD_TEMP_ROOT=tmp/bulk_downloads
