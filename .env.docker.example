APP_ENV=production
FLASK_DEBUG=false
FLASK_APP=wsgi.py

# Docker secrets are mounted by Compose; do not put SECRET_KEY, DATABASE_URL,
# ADMIN_PASSWORD, or the Cloudflare tunnel token in this file.
SECRET_KEY_FILE=/run/secrets/app_secret_key
DATABASE_URL_FILE=/run/secrets/database_url
ADMIN_PASSWORD_FILE=/run/secrets/admin_password

APP_PORT=6655
UPLOAD_ROOT=/app/storage/uploads
TMP_ROOT=/app/tmp
MAX_UPLOAD_MB=10
MAX_IMAGES_PER_SECTION=3

SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# memory:// is suitable for this internal deployment, but rate limits are per
# Gunicorn worker and reset when the app restarts.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_LOGIN_LIMIT=5 per minute
RATELIMIT_EXPORT_LIMIT=10 per hour

# Cloudflared is the only reverse proxy. Set this to your public hostname on
# the deployment host, not to an IP address.
TRUST_PROXY_HOPS=1
TRUSTED_HOSTS=report.example.internal

WEB_CONCURRENCY=2
GUNICORN_THREADS=2
RUN_MIGRATIONS=false
RUN_SECURITY_AUDIT=false
SEED_ADMIN=false
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=System Admin
